{
  "name": "@deeptimes/deployer",
  "type": "module",
  "version": "2.0.0",
  "description": "A global Nuxt deployment tool with profile-based release/current deployments over SSH.",
  "author": "leosin@qq.com",
  "license": "MIT",
  "keywords": [
    "nuxt",
    "deploy",
    "remote",
    "pm2",
    "application"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nuxter": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "deployer": "nuxter",
    "release": "pnpm run build && pnpm publish --access public",
    "vpatch": "npm version patch",
    "vminor": "npm version minor",
    "vmajor": "npm version major"
  },
  "dependencies": {
    "@deeptimes/deployer": "link:",
    "@inquirer/confirm": "^6.1.1",
    "@inquirer/core": "^11.2.1",
    "@inquirer/prompts": "^8.5.2",
    "@inquirer/select": "^5.2.1",
    "archiver": "^8.0.0",
    "chalk": "^5.6.2",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.5",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/node": "^25.9.2",
    "@types/ssh2": "^1.15.5",
    "eslint": "^10.4.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
